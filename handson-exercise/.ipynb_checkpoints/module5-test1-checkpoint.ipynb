   "source": [
    "def unique(number_list=[]):\n",
    "    new_number_list = []\n",
    "    for num in number_list:\n",
    "        if num not in new_number_list:\n",
    "            new_number_list.append(num)\n",
    "    return new_number_list\n",
    "    \n",
    "print(unique([1, 1, 4, 5, 1]))\n",
    "print(unique(['Mark', 'Mark', 'John', 'Anne']), )"
   ]
